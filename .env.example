# PostgreSQL version to use (14, 15, 16, 17, or 18)
POSTGRES_VERSION=16

# Hashtag dataset: URL to the 200k USA tweets CSV on OVH Cloud
# Leave unset to skip fetching at build time (but taop hashtag will fail at runtime)
HASHTAG_URL=https://storage.sbg.cloud.ovh.net/v1/AUTH_e5524010dbdf45ccb5cdac68b254c4f7/TAOP/dashboard_x_usa_x_filter_nativeretweets.csv
