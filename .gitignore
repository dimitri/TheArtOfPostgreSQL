.DS_Store

# Codespaces / devcontainer stamp file — marks that poststart.sh has already run.
# Created at runtime inside the workspace; must not be committed.
.devcontainer/.loaded

# regresql generates actual query output here during `regresql test` / `regresql update`.
# Only queries/regresql/expected/ (reference outputs) belongs in version control.
queries/regresql/out/
